----------------------------------------------------------------------
-- Element (shared methods)
----------------------------------------------------------------------
function ElementClass:_refreshVisible()
	self.Frame.Visible = self.Visible and not self._searchHidden
end

function ElementClass:SetVisible(visible)
	self.Visible = not not visible
	self:_refreshVisible()
	return self
end

function ElementClass:SetName(text)
	self.Name = tostring(text)
	self.SearchText = string.lower(self.Name)
	if self._title then
		self._title.Text = self.Name
	end
	return self
end

function ElementClass:Destroy()
	if self._destroyed then
		return
	end
	self._destroyed = true
	for _, cleanup in ipairs(self._cleanups) do
		pcall(cleanup)
	end
	self.Window:_unregister(self)
	self.Frame:Destroy()
end

----------------------------------------------------------------------
-- Section
----------------------------------------------------------------------
function SectionClass:_nextOrder()
	self._order = self._order + 1
	return self._order
end

function SectionClass:_base(kind, cfg, caller, opts)
	opts = opts or {}
	local window = self.Window
	window:_assertAlive(caller)
	local c = normalizeCfg(cfg, caller)

	local name
	if opts.noName then
		name = opt(c, "Name", "string", "")
	else
		name = opt(c, "Name", "string")
		if not name or name == "" then
			fail(caller .. " requires a non-empty 'Name' string", 3)
		end
	end
	local desc = opt(c, "Description", "string")
	if desc == "" then
		desc = nil
	end

	local baseHeight = desc and 50 or 38
	local totalHeight = baseHeight + (opts.extra or 0)

	local el = setmetatable({
		Kind = kind,
		Name = name,
		SearchText = string.lower(name .. " " .. (desc or "")),
		Section = self,
		Window = window,
		Visible = true,
		BaseHeight = baseHeight,
		Height = totalHeight,
		_cleanups = {},
		_destroyed = false,
		_searchHidden = false,
	}, ElementClass)

	if opts.flag then
		local explicit = opt(c, "Flag", "string")
		el.Save = opt(c, "Save", "boolean", true)
		el.Flag = window:_claimFlag(explicit, string.format("%s/%s/%s", self.Tab.Name, self.Name, name), el)
	end
	el.NotifyOverride = opt(c, "Notify", "boolean")
	el.CallOnInit = opt(c, "CallOnInit", "boolean", false)

	local frame
	if opts.bare then
		frame = create("Frame", {
			Name = kind,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 0, opts.bareHeight or 0),
			AutomaticSize = opts.bareHeight and Enum.AutomaticSize.None or Enum.AutomaticSize.Y,
			LayoutOrder = self:_nextOrder(),
			Parent = self.Container,
		})
	else
		frame = create("Frame", {
			Name = kind,
			BackgroundColor3 = Theme.Glass,
			BackgroundTransparency = Theme.RowT,
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 0, totalHeight),
			ClipsDescendants = true,
			LayoutOrder = self:_nextOrder(),
			Parent = self.Container,
		})
		corner(frame, 10)
		el._stroke = stroke(frame, WHITE, 1, Theme.RowStrokeT)
		local reserve = opts.rightReserve or 0
		local compact = opts.compact or desc ~= nil
		el._title = newLabel({
			Name = "Title",
			Text = name,
			Position = UDim2.fromOffset(14, compact and 7 or 0),
			Size = UDim2.new(1, -(28 + reserve), 0, compact and 18 or 38),
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = frame,
		})
		if desc then
			el._desc = newLabel({
				Name = "Description",
				Text = desc,
				Font = FONT,
				TextSize = 11,
				TextColor3 = Theme.SubText,
				Position = UDim2.fromOffset(14, 26),
				Size = UDim2.new(1, -(28 + reserve), 0, 14),
				TextTruncate = Enum.TextTruncate.AtEnd,
				Parent = frame,
			})
		end
	end
	el.Frame = frame

	table.insert(self.Elements, el)
	table.insert(window._elements, el)
	return el, c
end

function SectionClass:CreateLabel(cfg)
	local c0 = normalizeCfg(cfg, "CreateLabel", "Text")
	local el, c = self:_base("Label", c0, "CreateLabel", { noName = true, bare = true })
	local text = opt(c, "Text", "string", c.Name or "")
	padding(el.Frame, 2, 0, 2, 0)
	el._title = newLabel({
		Name = "Text",
		Text = text,
		Font = FONT,
		TextSize = 12,
		TextColor3 = Theme.SubText,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(4, 0),
		Size = UDim2.new(1, -8, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = el.Frame,
	})
	function el:SetText(value)
		return self:SetName(value)
	end
	function el:Get()
		return self.Name
	end
	el.Name = text
	el.SearchText = string.lower(text)
	return el
end

function SectionClass:CreateDivider(cfg)
	local c0 = normalizeCfg(cfg, "CreateDivider", "Text")
	local el, c = self:_base("Divider", c0, "CreateDivider", { noName = true, bare = true, bareHeight = 18 })
	local text = opt(c, "Text", "string")
	local line = create("Frame", {
		Name = "Line",
		BackgroundColor3 = Theme.Divider,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(1, 0, 0, 1),
		Parent = el.Frame,
	})
	create("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.2, 0.2),
			NumberSequenceKeypoint.new(0.8, 0.2),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = line,
	})
	if text and text ~= "" then
		local label = newLabel({
			Name = "Text",
			Text = text,
			Font = FONT_BOLD,
			TextSize = 11,
			TextColor3 = Theme.Accent,
			BackgroundTransparency = 0.15,
			BackgroundColor3 = Theme.AccentSoft,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(0, 0, 0, 18),
			AutomaticSize = Enum.AutomaticSize.X,
			TextXAlignment = Enum.TextXAlignment.Center,
			Parent = el.Frame,
		})
		corner(label, 9)
		padding(label, 0, 10, 0, 10)
		el._title = label
		el.SearchText = string.lower(text)
	end
	return el
end

function SectionClass:CreateButton(cfg)
	local el, c = self:_base("Button", cfg, "CreateButton", { rightReserve = 44 })
	local callback = opt(c, "Callback", "function")
	local primary = opt(c, "Style", "string", "Default") == "Primary"
	local frame = el.Frame

	if primary then
		frame.BackgroundTransparency = 0
		gradient(frame, Theme.Accent, Theme.Accent2, 0)
		el._stroke.Transparency = 1
		el._title.TextColor3 = Theme.OnAccent
		if el._desc then
			el._desc.TextColor3 = Color3.fromRGB(222, 238, 255)
		end
	end

	local hit = newButton({ Name = "Hit", Size = UDim2.fromScale(1, 1), Parent = frame })
	local chip = create("Frame", {
		Name = "Chip",
		BackgroundColor3 = primary and WHITE or Theme.AccentSoft,
		BackgroundTransparency = primary and 0.7 or 0,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(24, 24),
		Parent = frame,
	})
	corner(chip, 12)
	local arrow = newLabel({
		Name = "Arrow",
		Text = ">",
		Font = FONT_BOLD,
		TextSize = 13,
		TextColor3 = primary and Theme.OnAccent or Theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = chip,
	})

	if not primary then
		hoverRow(hit, frame, el._stroke)
	end
	hit.MouseEnter:Connect(function()
		if primary then
			tween(chip, { BackgroundTransparency = 0.4 }, TI_FAST)
		else
			tween(chip, { BackgroundColor3 = Theme.Accent }, TI_FAST)
			tween(arrow, { TextColor3 = Theme.OnAccent }, TI_FAST)
		end
		tween(chip, { Position = UDim2.new(1, -9, 0.5, 0) }, TI_SPRING)
	end)
	hit.MouseLeave:Connect(function()
		if primary then
			tween(chip, { BackgroundTransparency = 0.7 }, TI_FAST)
		else
			tween(chip, { BackgroundColor3 = Theme.AccentSoft }, TI_FAST)
			tween(arrow, { TextColor3 = Theme.Accent }, TI_FAST)
		end
		tween(chip, { Position = UDim2.new(1, -12, 0.5, 0) }, TI_MED)
	end)
	hit.MouseButton1Down:Connect(function()
		ripple(frame, primary and WHITE or Theme.Accent)
	end)
	hit.MouseButton1Click:Connect(function()
		fire(callback)
	end)

	function el:SetCallback(fn)
		if typeof(fn) ~= "function" then
			fail("Button:SetCallback expects a function", 2)
		end
		callback = fn
		return self
	end
	function el:Fire()
		fire(callback)
		return self
	end
	return el
end

function SectionClass:CreateToggle(cfg)
	local el, c = self:_base("Toggle", cfg, "CreateToggle", { flag = true, rightReserve = 66 })
	local window = el.Window
	local callback = opt(c, "Callback", "function")
	local value = opt(c, "Default", "boolean", false)
	local frame = el.Frame
	local pressed = false

	local track = create("Frame", {
		Name = "Track",
		BackgroundColor3 = Theme.Track,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(42, 22),
		Parent = frame,
	})
	corner(track, 11)
	local fill = create("Frame", {
		Name = "Fill",
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Parent = track,
	})
	corner(fill, 11)
	gradient(fill, Theme.Accent, Theme.Accent2, 0)
	local knob = create("Frame", {
		Name = "Knob",
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(16, 16),
		Parent = track,
	})
	corner(knob, 8)
	local glow = stroke(knob, Theme.Accent, 2, 1)
	local hit = newButton({ Name = "Hit", Size = UDim2.fromScale(1, 1), Parent = frame })
	hoverRow(hit, frame, el._stroke)

	local function render(instant)
		local info = instant and TI_INSTANT or TI_MED
		local width = pressed and 22 or 16
		local x = value and (42 - 3 - width) or 3
		tween(fill, { BackgroundTransparency = value and 0 or 1 }, info)
		tween(knob, {
			Position = UDim2.new(0, x, 0.5, 0),
			Size = UDim2.fromOffset(width, 16),
		}, instant and TI_INSTANT or TI_SPRING)
		tween(glow, { Transparency = value and 0.55 or 1 }, info)
	end

	local function setValue(v, source)
		local changed = v ~= value
		value = v
		render(false)
		if source ~= "silent" and (changed or source == "config") then
			fire(callback, value)
		end
		if changed then
			window:_changed(source)
		end
		return changed
	end

	hit.MouseButton1Down:Connect(function()
		pressed = true
		render(false)
		ripple(frame, Theme.Accent)
	end)
	hit.MouseButton1Up:Connect(function()
		pressed = false
		render(false)
	end)
	hit.MouseLeave:Connect(function()
		if pressed then
			pressed = false
			render(false)
		end
	end)
	hit.MouseButton1Click:Connect(function()
		if setValue(not value, "user") then
			window:_notifyChange(el, el.Name .. ": " .. (value and "Enabled" or "Disabled"), value and "Success" or "Info")
		end
	end)

	function el:Get()
		return value
	end
	function el:Set(v, silent)
		if typeof(v) ~= "boolean" then
			fail("Toggle:Set expects a boolean", 2)
		end
		setValue(v, silent and "silent" or "api")
		return self
	end
	function el:Toggle(silent)
		return self:Set(not value, silent)
	end
	el._serialize = function()
		return value
	end
	el._apply = function(raw)
		if typeof(raw) ~= "boolean" then
			return false
		end
		setValue(raw, "config")
		return true
	end
	el._initCall = function()
		fire(callback, value)
	end

	render(true)
	window:_finishElement(el)
	return el
end

function SectionClass:CreateSlider(cfg)
	local el, c = self:_base("Slider", cfg, "CreateSlider", { flag = true, compact = true, extra = 20, rightReserve = 96 })
	local window = el.Window
	local frame = el.Frame
	local min = opt(c, "Min", "number", 0)
	local max = opt(c, "Max", "number", 100)
	local inc = opt(c, "Increment", "number", 1)
	local suffix = opt(c, "Suffix", "string", "")
	local callback = opt(c, "Callback", "function")
	if not isFinite(min) or not isFinite(max) or min >= max then
		fail("CreateSlider: 'Min' must be a finite number lower than 'Max'", 2)
	end
	if not isFinite(inc) or inc <= 0 then
		fail("CreateSlider: 'Increment' must be a positive number", 2)
	end
	local decimals = math.max(decimalsOf(inc), decimalsOf(min), decimalsOf(max))
	decimals = math.min(decimals, 8)

	local function snap(v)
		v = math.clamp(v, min, max)
		v = min + math.floor((v - min) / inc + 0.5) * inc
		v = math.clamp(v, min, max)
		return tonumber(string.format("%." .. decimals .. "f", v))
	end
	local function format(v)
		return string.format("%." .. decimals .. "f", v) .. suffix
	end

	local defaultValue = opt(c, "Default", "number", min)
	if not isFinite(defaultValue) then
		fail("CreateSlider: 'Default' must be a finite number", 2)
	end
	local value = snap(defaultValue)

	local pill = create("Frame", {
		Name = "ValuePill",
		BackgroundColor3 = Theme.AccentSoft,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 7),
		Size = UDim2.fromOffset(0, 20),
		AutomaticSize = Enum.AutomaticSize.X,
		Parent = frame,
	})
	corner(pill, 10)
	padding(pill, 0, 9, 0, 9)
	local valueLabel = newLabel({
		Name = "Value",
		Text = format(value),
		Font = FONT_BOLD,
		TextSize = 12,
		TextColor3 = Theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		Parent = pill,
	})
	local barY = el.Height - 17
	local track = create("Frame", {
		Name = "Track",
		BackgroundColor3 = Theme.Track,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 14, 0, barY),
		Size = UDim2.new(1, -28, 0, 6),
		Parent = frame,
	})
	corner(track, 3)
	local fill = create("Frame", {
		Name = "Fill",
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
		Parent = track,
	})
	corner(fill, 3)
	gradient(fill, Theme.Accent, Theme.Accent2, 0)
	local knob = create("Frame", {
		Name = "Knob",
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(1, 0.5),
		Size = UDim2.fromOffset(14, 14),
		Parent = fill,
	})
	corner(knob, 9)
	local knobStroke = stroke(knob, Theme.Accent, 2.5, 0)
	local hit = newButton({
		Name = "Hit",
		Position = UDim2.new(0, 6, 0, barY - 11),
		Size = UDim2.new(1, -12, 0, 28),
		Parent = frame,
	})

	local hovering, dragging = false, false
	local function renderKnob()
		local big = hovering or dragging
		tween(knob, { Size = big and UDim2.fromOffset(19, 19) or UDim2.fromOffset(14, 14) }, TI_SPRING)
		tween(knobStroke, { Thickness = big and 3 or 2.5, Transparency = dragging and 0.25 or 0 }, TI_FAST)
	end

	local function render()
		valueLabel.Text = format(value)
		tween(fill, { Size = UDim2.fromScale((value - min) / (max - min), 1) }, TI_FAST)
	end

	local function setValue(v, source)
		v = snap(v)
		local changed = v ~= value
		value = v
		render()
		if source ~= "silent" and (changed or source == "config") then
			fire(callback, value)
		end
		if changed then
			window:_changed(source)
		end
		return changed
	end

	local dragConns = {}
	local changedWhileDragging = false
	local function setScrolling(enabled)
		local page = el.Section.Tab.Page
		if page then
			page.ScrollingEnabled = enabled
		end
	end
	local function stopDrag()
		for _, conn in ipairs(dragConns) do
			conn:Disconnect()
		end
		table.clear(dragConns)
		if dragging then
			dragging = false
			setScrolling(true)
			renderKnob()
			if changedWhileDragging then
				window:_notifyChange(el, el.Name .. ": " .. format(value), "Info")
			end
			changedWhileDragging = false
		end
	end
	local function updateFromX(x)
		local width = math.max(track.AbsoluteSize.X, 1)
		local rel = math.clamp((x - track.AbsolutePosition.X) / width, 0, 1)
		if setValue(min + (max - min) * rel, "user") then
			changedWhileDragging = true
		end
	end
	hit.MouseEnter:Connect(function()
		hovering = true
		renderKnob()
		tween(frame, { BackgroundTransparency = Theme.RowHoverT }, TI_FAST)
	end)
	hit.MouseLeave:Connect(function()
		hovering = false
		renderKnob()
		tween(frame, { BackgroundTransparency = Theme.RowT }, TI_FAST)
	end)
	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			stopDrag()
			dragging = true
			setScrolling(false)
			renderKnob()
			updateFromX(input.Position.X)
			table.insert(dragConns, UserInputService.InputChanged:Connect(function(changed)
				if dragging and (changed.UserInputType == Enum.UserInputType.MouseMovement or changed.UserInputType == Enum.UserInputType.Touch) then
					updateFromX(changed.Position.X)
				end
			end))
			table.insert(dragConns, UserInputService.InputEnded:Connect(function(ended)
				if ended.UserInputType == Enum.UserInputType.MouseButton1 or ended.UserInputType == Enum.UserInputType.Touch then
					stopDrag()
				end
			end))
		end
	end)
	table.insert(el._cleanups, stopDrag)

	function el:Get()
		return value
	end
	function el:Set(v, silent)
		if not isFinite(v) then
			fail("Slider:Set expects a finite number", 2)
		end
		setValue(v, silent and "silent" or "api")
		return self
	end
	el._serialize = function()
		return value
	end
	el._apply = function(raw)
		if not isFinite(raw) then
			return false
		end
		setValue(raw, "config")
		return true
	end
	el._initCall = function()
		fire(callback, value)
	end

	fill.Size = UDim2.fromScale((value - min) / (max - min), 1)
	window:_finishElement(el)
	return el
end

local function copyOptions(list, caller)
	if typeof(list) ~= "table" then
		fail(caller .. ": 'Options' must be an array of strings", 3)
	end
	local out, seen = {}, {}
	for _, item in ipairs(list) do
		if typeof(item) ~= "string" then
			fail(caller .. ": every option must be a string (got " .. typeof(item) .. ")", 3)
		end
		if not seen[item] then
			seen[item] = true
			table.insert(out, item)
		end
	end
	return out
end

function SectionClass:CreateDropdown(cfg)
	local el, c = self:_base("Dropdown", cfg, "CreateDropdown", { flag = true, rightReserve = 160 })
	local window = el.Window
	local frame = el.Frame
	local options = copyOptions(opt(c, "Options", "table", {}), "CreateDropdown")
	local multi = opt(c, "Multi", "boolean", false)
	local callback = opt(c, "Callback", "function")
	local headerH = el.BaseHeight

	local optionSet = {}
	for _, item in ipairs(options) do
		optionSet[item] = true
	end
	local selection = {}
	local open = false
	local token = 0
	local buttons = {}

	local function ordered()
		local out = {}
		for _, item in ipairs(options) do
			if selection[item] then
				table.insert(out, item)
			end
		end
		return out
	end
	local function getValue()
		local list = ordered()
		if multi then
			return list
		end
		return list[1]
	end
	local function displayText()
		local list = ordered()
		if #list == 0 then
			return "None"
		end
		return table.concat(list, ", ")
	end
	local function listHeight()
		return math.min(#options * 28 + 8, 160)
	end

	-- Returns a selection set, or nil when the raw value is invalid.
	local function normalizeValue(raw)
		local set = {}
		if raw == nil or raw == "" then
			return set
		end
		if typeof(raw) == "string" then
			if optionSet[raw] then
				set[raw] = true
				return set
			end
			return nil
		end
		if typeof(raw) == "table" then
			if #raw == 0 then
				return set
			end
			local any = false
			for _, item in ipairs(raw) do
				if typeof(item) == "string" and optionSet[item] then
					any = true
					if multi or next(set) == nil then
						set[item] = true
					end
				end
			end
			if not any then
				return nil
			end
			if not multi then
				for _, item in ipairs(options) do
					if set[item] then
						return { [item] = true }
					end
				end
			end
			return set
		end
		return nil
	end

	local header = newButton({ Name = "Header", Size = UDim2.new(1, 0, 0, headerH), Parent = frame })
	hoverRow(header, frame, el._stroke)
	local pill = create("Frame", {
		Name = "ValuePill",
		BackgroundColor3 = Theme.AccentSoft,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -34, 0, headerH / 2),
		Size = UDim2.fromOffset(122, 22),
		Parent = frame,
	})
	corner(pill, 11)
	local valueLabel = newLabel({
		Name = "Value",
		Text = "None",
		Font = FONT_MED,
		TextSize = 11,
		TextColor3 = Theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Size = UDim2.new(1, -12, 1, 0),
		Position = UDim2.fromOffset(6, 0),
		Parent = pill,
	})
	local arrow = create("TextLabel", {
		Name = "Arrow",
		BackgroundTransparency = 1,
		Text = ">",
		Font = FONT_BOLD,
		TextSize = 13,
		TextColor3 = Theme.Accent,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0, headerH / 2),
		Size = UDim2.fromOffset(14, 20),
		Parent = frame,
	})
	local list = create("ScrollingFrame", {
		Name = "List",
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 8, 0, headerH + 2),
		Size = UDim2.new(1, -16, 0, 0),
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Visible = false,
		Parent = frame,
	})
	corner(list, 8)
	padding(list, 4, 4, 4, 4)
	create("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })

	local function updateVisuals()
		valueLabel.Text = displayText()
		for item, button in pairs(buttons) do
			local selected = selection[item] == true
			tween(button, {
				BackgroundColor3 = selected and Theme.AccentSoft or WHITE,
				BackgroundTransparency = selected and 0 or 1,
				TextColor3 = selected and Theme.Accent or Theme.Text,
			}, TI_FAST)
		end
	end

	local function setOpen(state)
		open = state
		token = token + 1
		local mine = token
		if state then
			list.Visible = true
			list.Size = UDim2.new(1, -16, 0, listHeight())
			tween(frame, { Size = UDim2.new(1, 0, 0, headerH + 10 + listHeight()) }, TI_SLOW)
			tween(arrow, { Rotation = 90 }, TI_MED)
		else
			tween(frame, { Size = UDim2.new(1, 0, 0, headerH) }, TI_SLOW)
			tween(arrow, { Rotation = 0 }, TI_MED)
			task.delay(0.3, function()
				if token == mine and not el._destroyed then
					list.Visible = false
				end
			end)
		end
	end

	local function applySet(set, source)
		local before = table.concat(ordered(), "\31")
		selection = set
		local changed = before ~= table.concat(ordered(), "\31")
		updateVisuals()
		if source ~= "silent" and (changed or source == "config") then
			fire(callback, getValue())
		end
		if changed then
			window:_changed(source)
		end
		return changed
	end

	local function onPick(item)
		local set = {}
		if multi then
			for key in pairs(selection) do
				set[key] = true
			end
			set[item] = (not set[item]) or nil
		else
			set[item] = true
		end
		if applySet(set, "user") then
			window:_notifyChange(el, el.Name .. ": " .. displayText(), "Info")
		end
		if not multi then
			setOpen(false)
		end
	end

	local function buildOptions()
		for _, button in pairs(buttons) do
			button:Destroy()
		end
		table.clear(buttons)
		for index, item in ipairs(options) do
			local button = newButton({
				Name = "Option",
				Text = item,
				Font = FONT_MED,
				TextSize = 12,
				TextXAlignment = Enum.TextXAlignment.Left,
				BackgroundTransparency = 1,
				BackgroundColor3 = WHITE,
				Size = UDim2.new(1, 0, 0, 26),
				LayoutOrder = index,
				Parent = list,
			})
			corner(button, 6)
			padding(button, 0, 6, 0, 10)
			button.MouseEnter:Connect(function()
				if not selection[item] then
					tween(button, { BackgroundTransparency = 0.45 }, TI_FAST)
				end
			end)
			button.MouseLeave:Connect(function()
				if not selection[item] then
					tween(button, { BackgroundTransparency = 1 }, TI_FAST)
				end
			end)
			button.MouseButton1Click:Connect(function()
				onPick(item)
			end)
			buttons[item] = button
		end
	end

	header.MouseButton1Down:Connect(function()
		ripple(frame, Theme.Accent)
	end)
	header.MouseButton1Click:Connect(function()
		setOpen(not open)
	end)

	local defaultRaw = c.Default
	if defaultRaw ~= nil then
		local set = normalizeValue(defaultRaw)
		if not set then
			fail("CreateDropdown: 'Default' is not part of 'Options'", 2)
		end
		selection = set
	end
	buildOptions()
	updateVisuals()

	function el:Get()
		return getValue()
	end
	function el:Set(v, silent)
		local set = normalizeValue(v)
		if not set then
			fail("Dropdown:Set received a value that is not part of the options", 2)
		end
		applySet(set, silent and "silent" or "api")
		return self
	end
	function el:Clear(silent)
		applySet({}, silent and "silent" or "api")
		return self
	end
	function el:Refresh(newOptions, keepSelection)
		options = copyOptions(newOptions, "Dropdown:Refresh")
		optionSet = {}
		for _, item in ipairs(options) do
			optionSet[item] = true
		end
		local set = {}
		if keepSelection ~= false then
			for key in pairs(selection) do
				if optionSet[key] then
					set[key] = true
				end
			end
		end
		buildOptions()
		applySet(set, "api")
		if open then
			setOpen(true)
		end
		return self
	end
	el._serialize = function()
		local current = getValue()
		if multi then
			return current
		end
		return current or ""
	end
	el._apply = function(raw)
		local set = normalizeValue(raw)
		if not set then
			return false
		end
		applySet(set, "config")
		return true
	end
	el._initCall = function()
		if next(selection) ~= nil then
			fire(callback, getValue())
		end
	end

	window:_finishElement(el)
	return el
end

function SectionClass:CreateInput(cfg)
	local el, c = self:_base("Input", cfg, "CreateInput", { flag = true, rightReserve = 176 })
	local window = el.Window
	local frame = el.Frame
	local callback = opt(c, "Callback", "function")
	local placeholder = opt(c, "Placeholder", "string", "Type here...")
	local clearOnFocus = opt(c, "ClearOnFocus", "boolean", false)
	local numbersOnly = opt(c, "NumbersOnly", "boolean", false)
	local maxLength = opt(c, "MaxLength", "number")
	if maxLength ~= nil and (not isFinite(maxLength) or maxLength < 1) then
		fail("CreateInput: 'MaxLength' must be a positive number", 2)
	end
	local defaultRaw = c.Default
	if defaultRaw ~= nil and typeof(defaultRaw) ~= "string" and typeof(defaultRaw) ~= "number" then
		fail("CreateInput: 'Default' must be a string or number", 2)
	end

	local function sanitize(text)
		text = tostring(text)
		if numbersOnly then
			text = text:gsub("[^%d%.%-]", "")
		end
		if maxLength then
			local len = utf8.len(text)
			if len and len > maxLength then
				text = text:sub(1, utf8.offset(text, math.floor(maxLength) + 1) - 1)
			end
		end
		return text
	end

	local box = create("TextBox", {
		Name = "Box",
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.3,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(160, 26),
		Font = FONT,
		TextSize = 12,
		TextColor3 = Theme.Text,
		PlaceholderText = placeholder,
		PlaceholderColor3 = Theme.SubText,
		ClearTextOnFocus = clearOnFocus,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClipsDescendants = true,
		Text = "",
		Parent = frame,
	})
	corner(box, 8)
	padding(box, 0, 8, 0, 8)
	local boxStroke = stroke(box, Theme.Divider, 1, 0.3)

	local value = defaultRaw ~= nil and sanitize(defaultRaw) or ""
	if numbersOnly and value ~= "" and tonumber(value) == nil then
		fail("CreateInput: 'Default' is not a valid number", 2)
	end
	box.Text = value

	local function callbackArg()
		if numbersOnly then
			return tonumber(value)
		end
		return value
	end

	local function setValue(text, source)
		text = sanitize(text)
		if numbersOnly and text ~= "" and tonumber(text) == nil then
			return false
		end
		local changed = text ~= value
		value = text
		if box.Text ~= text then
			box.Text = text
		end
		if source ~= "silent" and (changed or source == "config") then
			fire(callback, callbackArg())
		end
		if changed then
			window:_changed(source)
		end
		return changed
	end

	local sanitizing = false
	box:GetPropertyChangedSignal("Text"):Connect(function()
		if sanitizing then
			return
		end
		local clean = sanitize(box.Text)
		if clean ~= box.Text then
			sanitizing = true
			box.Text = clean
			sanitizing = false
		end
	end)
	box.MouseEnter:Connect(function()
		tween(frame, { BackgroundTransparency = Theme.RowHoverT }, TI_FAST)
	end)
	box.MouseLeave:Connect(function()
		tween(frame, { BackgroundTransparency = Theme.RowT }, TI_FAST)
	end)
	box.Focused:Connect(function()
		tween(boxStroke, { Color = Theme.Accent, Thickness = 1.5, Transparency = 0 }, TI_FAST)
		tween(box, { BackgroundTransparency = 0.05 }, TI_FAST)
	end)
	box.FocusLost:Connect(function()
		tween(boxStroke, { Color = Theme.Divider, Thickness = 1, Transparency = 0.3 }, TI_FAST)
		tween(box, { BackgroundTransparency = 0.3 }, TI_FAST)
		local text = sanitize(box.Text)
		if numbersOnly and text ~= "" and tonumber(text) == nil then
			box.Text = value
			return
		end
		if setValue(text, "user") then
			window:_notifyChange(el, el.Name .. " updated", "Info")
		end
		box.Text = value
	end)

	function el:Get()
		return callbackArg()
	end
	function el:GetText()
		return value
	end
	function el:Set(v, silent)
		if typeof(v) ~= "string" and typeof(v) ~= "number" then
			fail("Input:Set expects a string or number", 2)
		end
		if not setValue(tostring(v), silent and "silent" or "api") and numbersOnly and tonumber(tostring(v)) == nil then
			fail("Input:Set received a non-numeric value for a NumbersOnly input", 2)
		end
		return self
	end
	el._serialize = function()
		return value
	end
	el._apply = function(raw)
		if typeof(raw) ~= "string" then
			return false
		end
		local clean = sanitize(raw)
		if numbersOnly and clean ~= "" and tonumber(clean) == nil then
			return false
		end
		setValue(clean, "config")
		return true
	end
	el._initCall = function()
		if value ~= "" then
			fire(callback, callbackArg())
		end
	end

	window:_finishElement(el)
	return el
end

function SectionClass:CreateKeybind(cfg)
	local el, c = self:_base("Keybind", cfg, "CreateKeybind", { flag = true, rightReserve = 118 })
	local window = el.Window
	local frame = el.Frame
	local callback = opt(c, "Callback", "function")
	local changedCallback = opt(c, "ChangedCallback", "function")
	local allowNone = opt(c, "AllowNone", "boolean", true)

	local okDefault, value = parseKey(c.Default)
	if not okDefault then
		fail("CreateKeybind: 'Default' must be an Enum.KeyCode or a valid key name", 2)
	end
	el.Value = value
	el._callback = callback

	local button = newButton({
		Name = "Key",
		Text = value and value.Name or "None",
		Font = FONT_BOLD,
		TextSize = 11,
		TextColor3 = Theme.Accent,
		BackgroundTransparency = 0.1,
		BackgroundColor3 = Theme.AccentSoft,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(100, 24),
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = frame,
	})
	corner(button, 12)
	local buttonStroke = stroke(button, Theme.Accent, 1.5, 1)
	hoverRow(button, frame, el._stroke)

	local function render()
		if window._listening == el then
			button.Text = "Press a key"
			tween(button, { BackgroundColor3 = Theme.Accent, TextColor3 = Theme.OnAccent }, TI_FAST)
			tween(buttonStroke, { Transparency = 0.5 }, TI_FAST)
		else
			button.Text = el.Value and el.Value.Name or "None"
			tween(button, { BackgroundColor3 = Theme.AccentSoft, TextColor3 = Theme.Accent }, TI_FAST)
			tween(buttonStroke, { Transparency = 1 }, TI_FAST)
		end
	end
	el._render = render

	local function setKey(key, source)
		local changed = key ~= el.Value
		el.Value = key
		render()
		if source ~= "silent" and (changed or source == "config") then
			fire(changedCallback, key or Enum.KeyCode.Unknown)
		end
		if changed then
			window:_changed(source)
		end
		return changed
	end

	el._capture = function(key)
		window:_setListening(nil)
		if key == Enum.KeyCode.Escape then
			return
		end
		if key == Enum.KeyCode.Backspace then
			if allowNone and setKey(nil, "user") then
				window:_notifyChange(el, el.Name .. ": None", "Info")
			end
			return
		end
		if key == Enum.KeyCode.Unknown then
			return
		end
		if setKey(key, "user") then
			window:_notifyChange(el, el.Name .. ": " .. key.Name, "Info")
		end
	end

	button.MouseButton1Click:Connect(function()
		ripple(frame, Theme.Accent)
		if window._listening == el then
			window:_setListening(nil)
		else
			window:_setListening(el)
		end
	end)

	table.insert(window._keybinds, el)

	function el:Get()
		return self.Value
	end
	function el:Set(key, silent)
		local ok, parsed = parseKey(key)
		if not ok or (parsed == nil and not allowNone) then
			fail("Keybind:Set expects an Enum.KeyCode or a valid key name", 2)
		end
		setKey(parsed, silent and "silent" or "api")
		return self
	end
	el._serialize = function()
		return el.Value and el.Value.Name or "None"
	end
	el._apply = function(raw)
		if typeof(raw) ~= "string" then
			return false
		end
		local ok, parsed = parseKey(raw)
		if not ok or (parsed == nil and not allowNone) then
			return false
		end
		setKey(parsed, "config")
		return true
	end

	window:_finishElement(el)
	return el
end

